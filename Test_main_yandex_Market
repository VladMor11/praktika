"""
Краткий юнит-тест для функции main() из yandex_market_tests.py
"""

import unittest
from unittest.mock import patch, MagicMock
import sys
import io


def test_main():
    """Тест основной функции main()"""
    print("\n🧪 Тестирование функции main() в Яндекс.Маркет")
    
    # Импортируем только функцию main из модуля
    # Внимание: ваш код не содержит явной функции main(), 
    # поэтому мы тестируем unittest.main()
    
    # Тест 1: Успешное выполнение всех тестов
    print("\nТест 1: Успешное выполнение всех тестов")
    
    with patch('unittest.main') as mock_main:
        mock_main.return_value = None  # unittest.main() не возвращает значение
        
        # Создаем макет для runner
        mock_runner = MagicMock()
        mock_result = MagicMock()
        mock_result.wasSuccessful.return_value = True
        mock_runner.run.return_value = mock_result
        
        with patch('unittest.TextTestRunner', return_value=mock_runner):
            # Имитируем вызов unittest.main()
            try:
                # В вашем коде при запуске напрямую вызывается unittest.main()
                # Мы тестируем этот блок
                with patch('__name__', '__main__'):
                    # Импортируем модуль
                    import yandex_market_tests
                    
                    # Проверяем, что unittest.main() был вызван
                    mock_main.assert_called_once()
                    print("✅ Тест 1 пройден: unittest.main() был вызван при успешных тестах")
            except SystemExit as e:
                # unittest.main() вызывает SystemExit
                # Проверяем код выхода
                if e.code == 0:
                    print("✅ Тест 1 пройден: код выхода 0 при успехе")
                else:
                    print(f"⚠️ Код выхода: {e.code}")
    
    # Тест 2: Провал некоторых тестов
    print("\nТест 2: Провал некоторых тестов")
    
    with patch('unittest.main') as mock_main:
        # Имитируем SystemExit с кодом ошибки
        mock_main.side_effect = SystemExit(1)
        
        try:
            with patch('__name__', '__main__'):
                import yandex_market_tests
        except SystemExit as e:
            if e.code == 1:
                print("✅ Тест 2 пройден: код выхода 1 при провале тестов")
            else:
                print(f"⚠️ Код выхода: {e.code}")
    
    # Тест 3: Критическая ошибка при запуске тестов
    print("\nТест 3: Критическая ошибка при запуске тестов")
    
    # Мокаем setUp для генерации исключения
    with patch('yandex_market_tests.YandexMarketTests.setUp', 
              side_effect=Exception("Ошибка инициализации драйвера")):
        
        # Создаем тестовый случай
        test_suite = unittest.TestLoader().loadTestsFromTestCase(
            yandex_market_tests.YandexMarketTests
        )
        
        # Запускаем тесты
        runner = unittest.TextTestRunner(verbosity=0)
        result = runner.run(test_suite)
        
        # Проверяем, что были ошибки
        self.assertTrue(len(result.errors) > 0 or len(result.failures) > 0,
                       "Ожидались ошибки при запуске тестов")
        print("✅ Тест 3 пройден: обнаружены ошибки при критической проблеме")
    
    print("\n🎉 Все тесты блока запуска Яндекс.Маркет пройдены!")


if __name__ == "__main__":
    test_main()
